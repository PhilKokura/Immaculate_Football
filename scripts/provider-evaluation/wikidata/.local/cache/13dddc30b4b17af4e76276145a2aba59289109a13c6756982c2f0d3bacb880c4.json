enschaft, wie …","language":"de"},"type":"monolingualtext"},"datatype":"monolingualtext"},"type":"statement","id":"Q88656450$1744B54E-6DBD-4ACA-BC85-CDB8B39BB9AE","rank":"normal"}],"P2860":[{"mainsnak":{"snaktype":"value","property":"P2860","hash":"7ce011415c1e8dfb83160ab05565ba8692c5d491","datavalue":{"value":{"entity-type":"item","numeric-id":95947357,"id":"Q95947357"},"type":"wikibase-entityid"},"datatype":"wikibase-item"},"type":"statement","id":"Q88656450$29FBA387-2A75-4FFB-9BC1-A3EE2F4373B6","rank":"normal"},{"mainsnak":{"snaktype":"value","property":"P2860","hash":"0fb4caf24b65ebbf806c314fb5e12589e3d34a93","datavalue":{"value":{"entity-type":"item","numeric-id":95948198,"id":"Q95948198"},"type":"wikibase-entityid"},"datatype":"wikibase-item"},"type":"statement","id":"Q88656450$2B306A2B-172E-42BF-B732-D127270321C9","rank":"normal"},{"mainsnak":{"snaktype":"value","property":"P2860","hash":"f4b32cc7d8d9e8eccab4f85cfdc34e5959ee7d8d","datavalue":{"value":{"entity-type":"item","numeric-id":3345156,"id":"Q3345156"},"type":"wikibase-entityid"},"datatype":"wikibase-item"},"type":"statement","id":"Q88656450$11A997FA-C708-4E10-8B28-3EEBA8639AA2","rank":"normal"},{"mainsnak":{"snaktype":"value","property":"P2860","hash":"478bda0f09b116f5319777a0eabe65bf9aad3056","datavalue":{"value":{"entity-type":"item","numeric-id":97097033,"id":"Q97097033"},"type":"wikibase-entityid"},"datatype":"wikibase-item"},"type":"statement","id":"Q88656450$A5295358-C978-4F5E-B4D9-E182B25757BF","rank":"normal"}]},"sitelinks":{"dewikisource":{"site":"dewikisource","title":"BLKÖ:Exner, Franz","badges":["Q20748093"],"url":"https://de.wikisource.org/wiki/BLK%C3%96:Exner,_Franz"}}}}}